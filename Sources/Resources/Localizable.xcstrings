    "settings.privacyBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All editing happens on your device. Nuvo does not connect to the internet, and your photos and personal information are never sent to anyone, including the developer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の加工はすべて端末の中で行います。Nuvo は通信を行わず、写真も個人情報も、開発者を含む誰にも送られません。"
          }
        }
      }
    },
    "settings.quality": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quality"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画質"
          }
        }
      }
    },
    "settings.stripLocation": {
